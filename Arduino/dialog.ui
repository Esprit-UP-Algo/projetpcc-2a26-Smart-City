                 <property name="text"><string>Délai moyen de traitement : 0 jours</string></property>
                 <property name="styleSheet"><string notr="true">QLabel { font-size:18px; }</string></property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>

           </layout>
          </item>

          <!-- GRAPH -->
          <item>
           <widget class="QChartView" name="chart" native="true">
            <property name="minimumSize">
             <size><width>0</width><height>260</height></size>
            </property>
           </widget>
          </item>

          <!-- CHATBOT -->
          <item>
           <widget class="QFrame" name="assistantCard">
            <property name="styleSheet">
             <string notr="true">
             QFrame {
                background:white;
                border:1px solid rgba(135,206,235,0.3);
                border-radius:14px; padding:20px;
             }
             QTextEdit, QLineEdit {
                border:1px solid rgba(135,206,235,0.3);
                border-radius:8px;
                padding:8px;
                background:#F8FAFC;
             }
             </string>
            </property>

            <layout class="QVBoxLayout" name="assistantLayout">

             <!-- TITLE -->
             <item>
              <widget class="QLabel" name="assistantLabel">
               <property name="styleSheet"><string notr="true">QLabel { font-size:16px; font-weight:600; color:#1F2D5C; }</string></property>
               <property name="text"><string>🤖 Assistant Financier</string></property>
              </widget>
             </item>
             <!-- CHAT OUTPUT -->
             <item>
              <widget class="QTextEdit" name="chatTextEdit">
               <property name="maximumSize"><size><width>16777215</width><height>140</height></size></property>
               <property name="readOnly"><bool>true</bool></property>
              </widget>
             </item>

             <!-- INPUT + SEND -->
             <item>
              <layout class="QHBoxLayout" name="questionLayout">
               <item>
                <widget class="QLineEdit" name="questionLineEdit">
                 <property name="placeholderText"><string>Poser une question…</string></property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="sendMessageButton">
                 <property name="styleSheet">
                  <string notr="true">
                  QPushButton {
                     background:#87CEEB; color:white;
                     font-weight:600; border-radius:8px;
                     padding:8px 16px;
                  }
                  QPushButton:hover { background:#6FB8FF; }
                  </string>
                 </property>
                 <property name="text"><string>Envoyer</string></property>
                </widget>
               </item>
              </layout>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
         </widget> <!-- FIN statsPage -->

        </widget> <!-- FIN stackedWidget -->
       </item>
      </layout>
     </widget>
    </item>
   </layout>
  </widget>

  <customwidgets>
   <customwidget>
    <class>QChartView</class>
    <extends>QWidget</extends>
    <header>qchartview.h</header>
   </customwidget>
  </customwidgets>

  <resources>
   <include location="resources.qrc"/>
  </resources>

  <connections/>
 </ui>
