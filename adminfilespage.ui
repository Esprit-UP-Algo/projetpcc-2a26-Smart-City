  <property name="styleSheet">
   <string notr="true">
   QWidget#AdminFilesPage {
       background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
           stop:0 #F7FAFC, stop:1 #EDF2F7);
       font-family: "Segoe UI", Arial, sans-serif;
   }

   QLabel {
       background: transparent;
   }

   QFrame {
       background-color: #FFFFFF;
       border: 1px solid #E1E8ED;
       border-radius: 14px;
   }

   QFrame#headerCard,
   QFrame#overviewCard,
   QFrame#operationsCard,
   QFrame#modulesCard {
       /* fake shadow look */
       border: 1px solid #E1E8ED;
   }

   QPushButton {
       background-color: #1F2D5C;
       color: #FFFFFF;
       border-radius: 6px;
       padding: 6px 12px;
       font-size: 11px;
       font-weight: 600;
       border: none;
   }

   QPushButton:hover {
       background-color: #2A3F6F;
   }

   QPushButton:pressed {
       background-color: #1A2648;
   }

   /* primary actions */
   QPushButton#btnBackup {
       background-color: #1F2D5C;
   }
   QPushButton#btnRestore {
       background-color: #3498DB;
   }
   QPushButton#btnImportAll {
       background-color: #27AE60;
   }
   QPushButton#btnPurge {
       background-color: #E74C3C;
   }

   QPushButton#btnBackup:hover     { background-color: #2A3F6F; }
   QPushButton#btnRestore:hover    { background-color: #2980B9; }
   QPushButton#btnImportAll:hover  { background-color: #229954; }
   QPushButton#btnPurge:hover      { background-color: #C0392B; }

   QCheckBox {
       font-size: 13px;
       color: #1F2D5C;
       spacing: 8px;
   }
   QCheckBox::indicator {
       width: 18px;
       height: 18px;
   }
   QCheckBox::indicator:unchecked {
       border: 2px solid #BDC3C7;
       border-radius: 3px;
       background-color: #FFFFFF;
   }
   QCheckBox::indicator:checked {
       border: 2px solid #1F2D5C;
       border-radius: 3px;
       background-color: #1F2D5C;
   }
   </string>
  </property>

