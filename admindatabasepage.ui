        <item>
         <widget class="QCheckBox" name="chkAutoBackup">
          <property name="text">
           <string>Sauvegarde automatique quotidienne</string>
          </property>
          <property name="styleSheet">
           <string notr="true">
           QCheckBox {
               font-size: 14px;
               color: #1F2D5C;
               spacing: 8px;
               background: transparent;
           }
           QCheckBox::indicator {
               width: 18px;
               height: 18px;
           }
           QCheckBox::indicator:unchecked {
               border: 2px solid #BDC3C7;
               border-radius: 3px;
               background-color: white;
           }
           QCheckBox::indicator:checked {
               border: 2px solid #1F2D5C;
               border-radius: 3px;
               background-color: #1F2D5C;
           }
           </string>
          </property>
