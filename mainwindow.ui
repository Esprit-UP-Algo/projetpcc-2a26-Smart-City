       <string notr="true">QComboBox {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0   #030b1a,   /* bleu nuit très profond */
        stop:0.5 #1e3a8a,   /* bleu marine soutenu */
        stop:1   #6366f1    /* bleu électrique/violet bleuté */
    );
    color: white;               /* texte en blanc */
    border: none;               /* pas de bordure classique */
    border-radius: 12px;        /* coins arrondis */
    padding: 6px 12px;          /* marges internes */
    font-weight: bold;          /* texte en gras */
    combobox-popup: 0;          /* style moderne pour la liste */
}

QComboBox:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0   #1e3a8a,
        stop:0.5 #2d4fcf,
        stop:1   #818cf8
    );
}

QComboBox:drop-down {
    border: none;                  /* enlève la bordure classique */
}

QComboBox::down-arrow {
    image: url(:/icons/arrow-down.png);  /* icône flèche personnalisée */
    width: 12px;
    height: 12px;
}
