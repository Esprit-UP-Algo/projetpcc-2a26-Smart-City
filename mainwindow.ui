      <property name="styleSheet">
       <string notr="true">QDateEdit {
    background-color: rgb(245, 245, 245);   /* fond gris clair */
    border: 1px solid rgb(200, 200, 200);   /* contour gris */
    border-radius: 12px;                    /* coins arrondis */
    padding: 6px;                           /* espace intérieur pour le texte */
    font-size: 14px;                        /* taille du texte */
    color: black;                           /* couleur du texte */
}

/* Pour le calendrier qui s’ouvre */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid rgb(200, 200, 200);
    border-radius: 0 12px 12px 0;
    background-color: rgb(245, 245, 245);
}

QDateEdit QCalendarWidget {
    background-color: rgb(245, 245, 245);   /* fond gris clair du calendrier */
    border: 1px solid rgb(200, 200, 200);   /* contour du calendrier */
    border-radius: 12px;
}
</string>
