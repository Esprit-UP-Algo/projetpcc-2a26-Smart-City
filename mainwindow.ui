}

QPushButton:hover {
    background-color: rgba(255,255,255,0.15);
}

QPushButton:checked {
    background-color: #123f8f; /* bleu nuit pas trop sombre */
    border: 1px solid #ffffff; /* conserver le contour lors de la sélection */
}
</string>
