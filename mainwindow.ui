      <property name="styleSheet">
       <string notr="true">QPushButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0   #030b1a,   /* bleu nuit très profond */
        stop:0.5 #1e3a8a,   /* bleu marine soutenu */
        stop:1   #6366f1    /* bleu électrique/violet bleuté */
    );
    color: white;              /* texte en blanc pour contraste */
    border: none;              /* pas de bordure classique */
    border-radius: 12px;       /* arrondi des coins */
    padding: 8px 16px;         /* marges internes */
    font-weight: bold;         /* texte en gras */
}

QPushButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0   #1e3a8a,   /* accentue le bleu marine */
        stop:0.5 #2d4fcf,   /* bleu plus lumineux */
        stop:1   #818cf8    /* violet plus clair */
    );
}

QPushButton:pressed {
    background: #030b1a;  /* foncé quand on clique */
}
</string>
