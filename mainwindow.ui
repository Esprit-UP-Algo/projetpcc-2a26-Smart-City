     <property name="styleSheet">
      <string notr="true">QLineEdit {
    background-color: transparent;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 15px;
    font-weight: 500;
    padding: 12px 18px;
    border-radius: 10px;
    margin: 4px 12px;
    border: 1px solid rgba(255,255,255,0.3); /* contour léger pour visibilité */
}

QLineEdit:focus {
    border: 1px solid rgba(255,255,255,0.6); /* contour plus clair au focus */
    background-color: rgba(255,255,255,0.05); /* petit effet au focus */
}
</string>
