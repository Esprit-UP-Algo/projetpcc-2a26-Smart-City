    background-color: rgb(245, 245, 245);   /* fond gris clair du menu */
    border: 1px solid rgb(200, 200, 200);   /* contour du menu */
    border-radius: 12px;                    /* coins arrondis du menu */
    selection-background-color: rgb(200, 200, 255); /* surlignage d'une option */
}</string>
