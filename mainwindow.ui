/* Bouton pour ouvrir le sélecteur d'heure (si présent) */
QTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid rgb(200, 200, 200);
    border-radius: 0 12px 12px 0;
    background-color: rgb(245, 245, 245);
}

/* Style du sélecteur de l’heure popup */
QTimeEdit QSpinBox {
    background-color: rgb(245, 245, 245);
    border: none;
    border-radius: 0;
    padding: 2px;
    color: black;
}
</string>
